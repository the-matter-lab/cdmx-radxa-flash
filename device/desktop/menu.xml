<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="desktop-menu" label="Workspaces">
    <item label="WORK — code"><action name="GoToDesktop"><to>1</to></action></item>
    <item label="AGENT — Pi / PicoClaw"><action name="GoToDesktop"><to>2</to></action></item>
    <item label="RUN — experiments"><action name="GoToDesktop"><to>3</to></action></item>
  </menu>

  <menu id="code-menu" label="Get workshop code">
    <item label="BayesOpt only">
      <action name="Execute"><command>/opt/cdmx-radxa-flash/device/desktop/open-workshop-repos.sh bayesopt</command></action>
    </item>
    <item label="Local AI only">
      <action name="Execute"><command>/opt/cdmx-radxa-flash/device/desktop/open-workshop-repos.sh local-ai</command></action>
    </item>
    <item label="Both repositories">
      <action name="Execute"><command>/opt/cdmx-radxa-flash/device/desktop/open-workshop-repos.sh all</command></action>
    </item>
  </menu>

  <menu id="agent-menu" label="Agent tools">
    <item label="Pi Agent">
      <action name="Execute"><command>/opt/cdmx-radxa-flash/device/desktop/open-agent.sh</command></action>
    </item>
    <item label="PicoClaw activity">
      <action name="Execute"><command>xterm -title 'PicoClaw Activity' -geometry 100x30 -fa Monospace -fs 10 -bg '#0b1020' -fg '#bfdbfe' -e /opt/cdmx-radxa-flash/device/desktop/code-viewer.sh</command></action>
    </item>
  </menu>

  <menu id="root-menu" label="CDMX Local AI">
    <item label="Open windows">
      <action name="ShowMenu"><menu>client-list-combined-menu</menu></action>
    </item>
    <separator/>
    <item label="Terminal">
      <action name="Execute"><command>/opt/cdmx-radxa-flash/device/desktop/open-terminal.sh</command></action>
    </item>
    <item label="Code editor">
      <action name="Execute"><command>/opt/cdmx-radxa-flash/device/desktop/open-editor.sh</command></action>
    </item>
    <menu id="code-menu"/>
    <menu id="agent-menu"/>
    <item label="System monitor">
      <action name="Execute"><command>/opt/cdmx-radxa-flash/device/desktop/open-monitor.sh</command></action>
    </item>
    <separator/>
    <item label="Instructions">
      <action name="Execute"><command>/opt/cdmx-radxa-flash/device/desktop/open-workshop-readme.sh</command></action>
    </item>
    <menu id="desktop-menu"/>
    <item label="Hide/show all windows"><action name="ToggleShowDesktop"/></item>
    <item label="Close active window"><action name="Close"/></item>
  </menu>
</openbox_menu>
