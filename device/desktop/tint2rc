# Minimal bottom panel: persistent app launchers, open windows, workspaces,
# compact hardware status, and clock. Nothing is placed over the wallpaper.
rounded = 0
border_width = 0
background_color = #090d16 96
border_color = #090d16 100

rounded = 5
border_width = 0
background_color = #172033 100
border_color = #172033 100

rounded = 5
border_width = 0
background_color = #2563eb 100
border_color = #2563eb 100

rounded = 5
border_width = 1
background_color = #111827 100
border_color = #334155 100

# Five pinned launchers, taskbar, tray, system status, clock.
panel_items = EEEEETSEC
panel_monitor = all
panel_position = bottom center horizontal
panel_size = 100% 42
panel_margin = 0 0
panel_padding = 5 3 5
panel_background_id = 1
panel_layer = top
# Let tint2 honor panel_position. Openbox's generic dock placement otherwise
# forces dock windows to the top-left regardless of this setting.
panel_dock = 0
wm_menu = 1
strut_policy = follow_size

taskbar_mode = multi_desktop
taskbar_padding = 2 1 2
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 1
taskbar_name_padding = 7 4
taskbar_name_background_id = 2
taskbar_name_active_background_id = 3
taskbar_name_font = Sans Bold 9
taskbar_name_font_color = #cbd5e1 100
taskbar_name_active_font_color = #ffffff 100

task_icon = 0
task_text = 1
task_centered = 1
task_maximum_size = 145 32
task_padding = 7 2 4
task_background_id = 0
task_active_background_id = 3
task_font = Sans 9
task_font_color = #cbd5e1 100
task_active_font_color = #ffffff 100

systray_padding = 4 2 4
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 18

time1_format = %H:%M
time1_timezone = :America/Mexico_City
time1_font = Sans Bold 10
clock_font_color = #f8fafc 100
clock_padding = 9 0
clock_background_id = 0
clock_tooltip = %A, %d %B %Y

# APPS
execp = new
execp_command = printf ' APPS '
execp_interval = 0
execp_has_icon = 0
execp_tooltip = Open applications and workspace menu
execp_lclick_command = /opt/cdmx-radxa-flash/device/desktop/open-apps-menu.sh
execp_font = Sans Bold 9
execp_font_color = #9ff7b5 100
execp_padding = 8 0
execp_background_id = 4
execp_centered = 1

# TERMINAL
execp = new
execp_command = printf ' Terminal '
execp_interval = 0
execp_has_icon = 0
execp_tooltip = Open a terminal in ~/workspace
execp_lclick_command = /opt/cdmx-radxa-flash/device/desktop/open-terminal.sh
execp_font = Sans 9
execp_font_color = #e2e8f0 100
execp_padding = 6 0
execp_background_id = 0
execp_centered = 1

