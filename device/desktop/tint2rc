# Compact one-line status; click it to open the full monitor. No uptime counter.
execp = new
execp_command = /opt/cdmx-radxa-flash/device/desktop/system-status.sh
execp_interval = 3
execp_has_icon = 0
execp_tooltip = CPU, RAM, and temperature — click for details
execp_lclick_command = /opt/cdmx-radxa-flash/device/desktop/open-monitor.sh
execp_font = Sans 9
execp_font_color = #86efac 100
execp_padding = 8 0
execp_background_id = 0
execp_centered = 1

mouse_left = toggle_iconify
mouse_middle = none
mouse_right = none
mouse_scroll_up = toggle
mouse_scroll_down = iconify
