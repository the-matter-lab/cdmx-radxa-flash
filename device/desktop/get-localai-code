#!/bin/bash
set -euo pipefail

cd -- "$(dirname -- "$0")"
if [[ -d cdmx-local-ai/.git ]]; then
    git -C cdmx-local-ai pull --ff-only
else
    git clone https://github.com/the-matter-lab/cdmx-local-ai.git cdmx-local-ai
fi

printf '\nLocal AI code is ready in ~/workspace/cdmx-local-ai.\n'
printf 'Its skills and tools remain inside that clone. Continue with:\n'
printf '  cd ~/workspace/cdmx-local-ai\n'
printf '  picoclaw onboard\n'
