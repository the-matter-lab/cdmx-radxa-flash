# Add this inside the Caddy server that receives the Cloudflare Tunnel.
@cdmx_radxa_flash host cdmx-radxaflash.mantilla.ca
handle @cdmx_radxa_flash {
	root * /Users/Shared/srv/http/mantilla.ca/cdmx-radxa-flash
	header {
		Content-Security-Policy "default-src 'self'; connect-src 'self' http://127.0.0.1:8766; font-src 'self'; frame-ancestors 'none'; img-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; form-action 'none'; base-uri 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
	}
	@cdmx_manifest path /manifest.json
	header @cdmx_manifest Cache-Control "no-store"
	@cdmx_downloads path /downloads/*
	header @cdmx_downloads {
		Cache-Control "public, max-age=31536000, immutable"
		Content-Disposition "attachment"
	}
	file_server
}
